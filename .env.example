# Copy these into Vercel > Project > Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Optional: override the writing model
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe (Developers > API keys, and the two monthly prices you create)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TIMELINE=
STRIPE_PRICE_DEEP=
STRIPE_PRICE_TIMELINE_YEARLY=
STRIPE_PRICE_DEEP_YEARLY=
# One-time purchases (leave blank to hide one, or turn it off in lib/config.ts)
STRIPE_PRICE_ONE_QUESTION=
STRIPE_PRICE_ONE_SYNASTRY=
STRIPE_PRICE_ONE_SYNASTRY_FOUNDING=
STRIPE_PRICE_ONE_YEARAHEAD=

# Resend email (resend.com > API Keys)
RESEND_API_KEY=

# Phone notifications: run `npx web-push generate-vapid-keys` once and paste both
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@yourdomain.com

# Protects the delivery scheduler. Any long random string.
CRON_SECRET=

# Your login email(s), comma separated: unlocks /admin
ADMIN_EMAILS=
